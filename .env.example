# Copiar a .env y completar. Nunca subir .env al repositorio.
ENVIRONMENT=local

POSTGRES_USER=orminorth
POSTGRES_PASSWORD=orminorth
POSTGRES_DB=orminorth
POSTGRES_PORT=5433
REDIS_PORT=6380
API_PORT=8000

# Modulo 5: clave que usara el CRM Central de la agencia.
# Mientras siga en "change-me" el endpoint daily-audit responde 503.
AGENCY_MASTER_KEY=change-me

# Integraciones (dejar vacio = el Centinela lo reporta NO_CONFIGURADO)
