# Copiar a .env y completar. Nunca subir .env al repositorio.
ENVIRONMENT=local

POSTGRES_USER=orminorth
POSTGRES_PASSWORD=orminorth
POSTGRES_DB=orminorth
POSTGRES_PORT=5433
REDIS_PORT=6380
API_PORT=8000

# ---------------------------------------------------------------------
# Modulo 5: clave que usara el CRM Central de la agencia.
# Mientras siga en "change-me" el endpoint daily-audit responde 503.
# SENTINEL_MASTER_KEY (ratificado 2026-11-08) gana sobre AGENCY_MASTER_KEY.
# ---------------------------------------------------------------------
AGENCY_MASTER_KEY=change-me
SENTINEL_MASTER_KEY=

# ---------------------------------------------------------------------
# v4.4.0: router HTTP del Custodio. Tokens de servicio por rol, no login.
# Si ninguno esta configurado y CUSTODIO_ALLOW_DEV_HEADER=false, responde 503.
# ---------------------------------------------------------------------
CUSTODIO_TOKEN_SUPERADMIN=
CUSTODIO_TOKEN_CONTADORA=
CUSTODIO_TOKEN_SECRETARIA=
CUSTODIO_TOKEN_BODEGA=
CUSTODIO_TOKEN_CHOFER=
CUSTODIO_TOKEN_SYSTEM_CRON=
CUSTODIO_ALLOW_DEV_HEADER=false
GATE_API_KEY=

# Push de alertas del Modulo 1 al CRM de la agencia (PDR 4.2).
# Vacio = las alertas quedan solo en error_logs y se reporta NO_CONFIGURADO.
AGENCY_CRM_WEBHOOK_URL=

# ---------------------------------------------------------------------
# Modulo 1: ventana de agrupacion de mensajes (PDR: 14 s).
# DEBOUNCE_SECONDS vacio = se lee operacion.debounce_segundos de la BD.
# ---------------------------------------------------------------------
DEBOUNCE_SECONDS=14
DEBOUNCE_POLL_SECONDS=1
WHATSAPP_WORKER_ENABLED=true

# Juez Binario "Jeb". Sin GEMINI_API_KEY usa el juez deterministico.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=8

# Evidencias del chofer (PDR: ningun archivo en el VPS).
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_ENDPOINT=https://storage.bunnycdn.com
# Token authentication del Pull Zone (recomendado). Si esta vacio, las URLs
# del CDN salen sin firma y cualquiera con el enlace puede abrirlas.
BUNNY_TOKEN_KEY=
# Topes de multimedia del cliente (MB). Se validan antes de procesar.
MEDIA_MAX_IMAGEN_MB=25
MEDIA_MAX_VIDEO_MB=250
MEDIA_MAX_AUDIO_MB=40
MEDIA_MAX_DOCUMENTO_MB=25

# ---------------------------------------------------------------------
# Integraciones (dejar vacio = el Centinela lo reporta NO_CONFIGURADO)
# ---------------------------------------------------------------------
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
BUNNY_CDN_HOST=

# v5.1 - backup diario (scripts/backup_db.sh)
BACKUP_DIR=/backups/horminor
BACKUP_DAILY_KEEP_DAYS=14
BACKUP_MONTHLY_KEEP=6
BACKUP_VERIFY=1

LOG_LEVEL=INFO

# Gato / DeepSeek (asistente interno)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
GATO_LLM=1
