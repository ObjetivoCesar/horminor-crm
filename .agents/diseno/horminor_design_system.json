  "views": {
    "secretaria": {
      "blocks": ["alta rápida de orden", "cierre de caja (plegable)", "cobros del día (plegable, solo lectura)", "cartera"],
      "limitation": "No existe POST de pagos/abonos: no se inventan movimientos"
    },
    "clientes": {
      "pattern": "maestro-detalle",
      "autoselect": "primer cliente con total_m3 > 0 ordenado por total_m3 descendente",
      "reason": "evita el panel derecho vacío y prioriza Ing. Reyes (372 m³)",
      "detail": ["carpeta forense", "timeline", "órdenes", "evidencias Bunny"]
    },
    "planta": {
      "blocks": ["stock", "kardex teórico vs real", "flota de mixers"],
      "source": "/api/v1/inventory + /api/v1/dashboard/hero-kpis + /api/v1/secretaria/opciones"
    },
    "banca": {
      "summary": {
        "market_m3": 215000,
        "sales_m3": 404,
        "share_pct": 0.19,
        "gap_m3": 214596
      },
      "blocks": ["resumen numérico de mercado", "filas por provincia", "dossier", "simulador francés"],
      "source": "/api/v1/dashboard/mercado + /api/v1/dashboard/simulador + /api/v1/orders",
      "note": "Sin párrafos largos: 4 cifras grandes y barras por provincia"
    },
    "superadmin": {
      "blocks": ["simulador WhatsApp", "outbox plegado (4 mensajes resumidos)", "configuración en caliente con selector desplegable"],
      "ids": ["sim-remitente", "sim-texto", "sim-foto", "sim-resultado", "outbox-card", "outbox-count", "outbox-panel", "config-tabs", "config-seccion", "config-panel"]
