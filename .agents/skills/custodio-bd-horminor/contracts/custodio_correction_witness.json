{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_name": "custodio_correction_witness",
  "version": "1.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "channel",
    "intent",
    "target_table",
    "motivo",
    "changes"
  ],
  "properties": {
    "contract_version": { "type": "string", "const": "1.3.0" },
    "request_id": { "type": "string", "format": "uuid" },
    "channel": {
      "type": "string",
      "enum": ["WEB_PANEL", "WHATSAPP", "TEST"]
    },
    "intent": {
      "type": "string",
      "enum": [
        "CORRECT_MOVEMENT_WITH_WITNESS",
        "CREATE_ACCOUNTING_CATEGORY",
        "RENAME_ACCOUNTING_CATEGORY",
        "MERGE_ACCOUNTING_CATEGORIES"
      ]
    },
    "target_table": {
      "type": "string",
      "enum": [
        "payments",
        "purchases",
        "supplier_payments",
        "inventory_movements",
        "accounting_accounts"
      ]
    },
    "target_record_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 40
    },
    "motivo": { "type": "string", "minLength": 10, "maxLength": 300 },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nuevo_monto": {
          "type": ["string", "null"],
          "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"
        },
        "nuevo_metodo": {
          "type": ["string", "null"],
          "enum": ["EFECTIVO", "TRANSFERENCIA", null]
        },
        "nueva_bolsa": {
          "type": ["string", "null"],
          "enum": ["CAJA_DIARIA", "BANCO_GERENCIA", null]
        },
        "nuevo_account_slug": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9_]+$"
        },
        "nuevo_nombre_categoria": {
          "type": ["string", "null"],
          "minLength": 3,
          "maxLength": 80
        },
        "account_type": {
          "type": ["string", "null"],
          "enum": ["ASSET", "LIABILITY", "EQUITY", "REVENUE", "EXPENSE", null]
        },
        "normal_balance": {
          "type": ["string", "null"],
          "enum": ["DEBIT", "CREDIT", null]
        },
        "parent_group": {
          "type": ["string", "null"],
          "enum": [
            "ACTIVO_CORRIENTE",
            "ACTIVO_NO_CORRIENTE",
            "PASIVO_CORRIENTE",
            "PASIVO_LARGO_PLAZO",
            "PATRIMONIO_NETO",
            "INGRESO_OPERATIVO",
            "COSTO_DIRECTO",
            "CIF_PLANTA",
            "GASTO_ADMIN_FIJO",
            "CAJA_CHICA",
            "FISCAL_FINANCIERO",
            null
          ]
        },
        "default_bolsa": {
          "type": ["string", "null"],
          "enum": [
            "CAJA_DIARIA",
            "BANCO_GERENCIA",
            "CARTERA_O_PASIVO",
            "NO_MONETARIO",
            null
          ]
        },
        "requires_voucher": { "type": ["boolean", "null"] },
        "source_account_id": {
          "type": ["string", "null"],
          "format": "uuid"
        },
        "target_account_id": {
          "type": ["string", "null"],
          "format": "uuid"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "intent": { "const": "CREATE_ACCOUNTING_CATEGORY" }
        }
      },
      "then": {
        "properties": {
          "target_table": { "const": "accounting_accounts" },
          "changes": {
            "required": [
              "nuevo_nombre_categoria",
              "account_type",
              "normal_balance",
              "parent_group",
              "default_bolsa",
              "requires_voucher"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "intent": { "const": "RENAME_ACCOUNTING_CATEGORY" }
        }
      },
      "then": {
        "properties": {
          "target_table": { "const": "accounting_accounts" },
          "changes": { "required": ["nuevo_nombre_categoria"] }
        },
        "required": ["target_record_id"]
      }
    },
    {
      "if": {
        "properties": {
          "intent": { "const": "MERGE_ACCOUNTING_CATEGORIES" }
        }
      },
      "then": {
        "properties": {
          "target_table": { "const": "accounting_accounts" },
          "changes": {
            "required": ["source_account_id", "target_account_id"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "intent": { "const": "CORRECT_MOVEMENT_WITH_WITNESS" }
        }
      },
      "then": {
        "properties": {
          "target_table": {
            "enum": ["payments", "purchases", "supplier_payments"]
          },
          "changes": {
            "anyOf": [
              { "required": ["nuevo_monto"] },
              { "required": ["nuevo_metodo"] },
              { "required": ["nueva_bolsa"] },
              { "required": ["nuevo_account_slug"] }
            ]
          }
        },
        "required": ["target_record_id"]
      }
    }
  ]
}
